{
  "name": "sk-mcp",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint validate format:check",
    "validate": "turbo run validate",
    "format": "prettier --write \"**/*.{ts,tsx,md,mjs}\"",
    "check-types": "turbo run check-types",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mjs}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  }
}
