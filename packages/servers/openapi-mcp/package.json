{
  "name": "@liaiso/openapi-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that exposes an OpenAPI document as a search-first liaiso catalog over a remote backend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "liaiso-openapi": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@liaiso/core": "workspace:*",
    "@liaiso/openapi": "workspace:*",
    "zod": "^4.5.4"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@liaiso/oxlint-config": "workspace:*",
    "@liaiso/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
