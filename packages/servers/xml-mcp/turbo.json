{
  "extends": ["//"],
  "tasks": {
    "build": { "inputs": ["$TURBO_DEFAULT$", "!test/**", "!vitest.config.ts"] },
    "test": { "dependsOn": ["build"], "env": ["LIAISO_XML_LARGE"] },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "env": ["LIAISO_XML_LARGE"]
    }
  }
}
