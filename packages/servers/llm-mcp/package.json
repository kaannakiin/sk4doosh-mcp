{
  "name": "@liaiso/llm-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets a planning agent hand bounded language work to a local model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaannakiin/liaiso.git",
    "directory": "packages/servers/llm-mcp"
  },
  "homepage": "https://github.com/kaannakiin/liaiso/tree/main/packages/servers/llm-mcp#readme",
  "bugs": {
    "url": "https://github.com/kaannakiin/liaiso/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "liaiso-llm": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@liaiso/mcp-core": "workspace:^",
    "zod": "^4.5.4"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@liaiso/oxlint-config": "workspace:*",
    "@liaiso/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
