{
  "name": "@liaiso/ocr-ollama",
  "version": "0.1.0",
  "description": "OcrProvider for @liaiso/pdf-mcp, backed by an Ollama vision model.",
  "keywords": [
    "ocr",
    "ollama",
    "vision",
    "pdf",
    "pdf-mcp",
    "mcp",
    "liaiso"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaannakiin/liaiso.git",
    "directory": "packages/adapters/ocr-ollama"
  },
  "homepage": "https://github.com/kaannakiin/liaiso/tree/main/packages/adapters/ocr-ollama#readme",
  "bugs": {
    "url": "https://github.com/kaannakiin/liaiso/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@liaiso/oxlint-config": "workspace:*",
    "@liaiso/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
