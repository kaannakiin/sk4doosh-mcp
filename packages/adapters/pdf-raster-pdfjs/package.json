{
  "name": "@sk-mcp/pdf-raster-pdfjs",
  "version": "0.1.0",
  "description": "PageRasterizer for @sk-mcp/pdf-mcp, backed by pdf.js and a Node canvas.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@sk-mcp/eslint-config": "workspace:*",
    "@sk-mcp/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "eslint": "10.9.1",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
