{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture.schema.json",
  "title": "Fixture",
  "oneOf": [
    {
      "$ref": "#/$defs/NamingFixture"
    },
    {
      "$ref": "#/$defs/MetadataExtractionFixture"
    },
    {
      "$ref": "#/$defs/ArgumentMappingFixture"
    },
    {
      "$ref": "#/$defs/SelectionFixture"
    },
    {
      "$ref": "#/$defs/VisibilityFixture"
    },
    {
      "$ref": "#/$defs/SearchFixture"
    },
    {
      "$ref": "#/$defs/ErrorMappingFixture"
    },
    {
      "$ref": "#/$defs/SchemaSimplificationFixture"
    },
    {
      "$ref": "#/$defs/CardFixture"
    }
  ],
  "$defs": {
    "ErrorMappingFixture": {
      "title": "ErrorMappingFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "error-mapping"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/BackendResponseSpec"
        },
        "expected": {
          "$ref": "invoke-result.schema.json"
        }
      }
    },
    "BackendResponseSpec": {
      "title": "BackendResponseSpec",
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "contentType": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array"
            }
          ]
        },
        "knownFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fieldAliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Wire field name to agent argument name."
        },
        "hiddenFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Wire field names the agent cannot set; a reported field matching one is emitted without a name."
        }
      }
    },
    "NamingFixture": {
      "title": "NamingFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "naming"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoints"],
          "properties": {
            "endpoints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/NamingEndpoint"
              }
            },
            "prefixMode": {
              "$ref": "#/$defs/PrefixMode"
            },
            "hostPrefixes": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "title": "NamingExpectedNames",
              "type": "object",
              "additionalProperties": false,
              "required": ["names"],
              "properties": {
                "names": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "title": "NamingExpectedError",
              "type": "object",
              "additionalProperties": false,
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "string",
                  "enum": ["name_collision", "invalid_name"]
                }
              }
            }
          ]
        }
      }
    },
    "NamingEndpoint": {
      "title": "NamingEndpoint",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "route"],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"]
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "containerPrefix": {
          "type": "string",
          "minLength": 1
        },
        "toolName": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "endpoint-descriptor.schema.json#/$defs/ToolVariant"
          }
        }
      }
    },
    "PrefixMode": {
      "title": "PrefixMode",
      "type": "string",
      "enum": ["always", "onCollision"]
    },
    "MetadataExtractionFixture": {
      "title": "MetadataExtractionFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "metadata-extraction"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "endpoint-descriptor.schema.json"
        },
        "foldedRoutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Routes folded away from input.route. A declaration that resolves only on one of these is spared with curation_unused_on_kept_route rather than dropping the endpoint."
        },
        "expected": {
          "oneOf": [
            {
              "$ref": "tool-definition.schema.json"
            },
            {
              "title": "MetadataExtractionExpectedTools",
              "type": "object",
              "additionalProperties": false,
              "required": ["tools"],
              "properties": {
                "tools": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "tool-definition.schema.json"
                  }
                }
              },
              "description": "Used when the endpoint declares variants: one tool per variant, in declaration order."
            },
            {
              "title": "MetadataExtractionExpectedError",
              "type": "object",
              "additionalProperties": false,
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "argument_collision",
                    "schema_def_conflict",
                    "duplicate_argument",
                    "curation_unresolved",
                    "invalid_fill_constant",
                    "hidden_required_omitted",
                    "variant_declaration_conflict"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "ArgumentMappingFixture": {
      "title": "ArgumentMappingFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "argument-mapping"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["template", "arguments"],
          "properties": {
            "template": {
              "$ref": "#/$defs/RequestTemplateSpec"
            },
            "arguments": {
              "type": "object"
            },
            "deferred": {
              "type": "object",
              "description": "Resolved deferred values keyed by source name. The runner builds the provider from this map, the way naming fixtures build Naming.Prefix from hostPrefixes."
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "title": "ComposedRequestExpectation",
              "type": "object",
              "additionalProperties": false,
              "required": ["pathAndQuery"],
              "properties": {
                "pathAndQuery": {
                  "type": "string"
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "bodyJson": {
                  "oneOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "array"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              }
            },
            {
              "title": "ArgumentMappingError",
              "type": "object",
              "additionalProperties": false,
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "string",
                  "enum": [
                    "unknown_argument",
                    "invalid_path_type",
                    "missing_path_parameter",
                    "header_injection",
                    "null_not_allowed",
                    "invalid_type",
                    "deferred_value_missing",
                    "deferred_value_invalid"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "RequestTemplateSpec": {
      "title": "RequestTemplateSpec",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "route"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"]
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemplateParameter"
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": ["properties"],
          "properties": {
            "properties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "additionalProperties": {
              "type": "boolean"
            },
            "curation": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TemplateBodyCuration"
              }
            }
          }
        },
        "bodyRoot": {
          "type": "string",
          "minLength": 1
        },
        "rootFill": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/ArgumentFill",
          "description": "Fills the body root argument; only meaningful with bodyRoot."
        }
      }
    },
    "TemplateParameter": {
      "title": "TemplateParameter",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "in", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "in": {
          "type": "string",
          "enum": ["path", "query", "header"]
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean"]
        },
        "array": {
          "type": "boolean"
        },
        "style": {
          "type": "string",
          "enum": ["form", "spaceDelimited", "pipeDelimited"]
        },
        "explode": {
          "type": "boolean"
        },
        "as": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "The name the agent sends. The wire name stays in 'name'."
        },
        "fill": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/ArgumentFill",
          "description": "Present means hidden: the agent cannot send this parameter and the value is written from here."
        }
      }
    },
    "SelectionFixture": {
      "title": "SelectionFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "selection"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "operations"],
          "properties": {
            "default": {
              "$ref": "#/$defs/SelectionDefault"
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/SelectionOperation"
              }
            }
          }
        },
        "expected": {
          "oneOf": [
            {
              "title": "SelectionExpectedIds",
              "type": "object",
              "additionalProperties": false,
              "required": ["selected"],
              "properties": {
                "selected": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "title": "SelectionExpectedError",
              "type": "object",
              "additionalProperties": false,
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "string",
                  "enum": ["ambiguous_selection"]
                }
              }
            }
          ]
        }
      }
    },
    "SelectionOperation": {
      "title": "SelectionOperation",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "$ref": "#/$defs/SelectionMarker"
        },
        "operation": {
          "$ref": "#/$defs/SelectionMarker"
        }
      }
    },
    "SelectionDefault": {
      "type": "string",
      "enum": ["include", "exclude"]
    },
    "SelectionMarker": {
      "type": "string",
      "enum": ["include", "exclude", "both"]
    },
    "VisibilityFixture": {
      "title": "VisibilityFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "visibility"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auth", "caller"],
          "properties": {
            "auth": {
              "$ref": "endpoint-descriptor.schema.json#/$defs/Auth"
            },
            "caller": {
              "$ref": "#/$defs/CallerFacts"
            }
          }
        },
        "expected": {
          "title": "VisibilityExpectation",
          "type": "object",
          "additionalProperties": false,
          "required": ["decision"],
          "properties": {
            "decision": {
              "$ref": "#/$defs/VisibilityDecision"
            }
          }
        }
      }
    },
    "CallerFacts": {
      "title": "CallerFacts",
      "type": "object",
      "additionalProperties": false,
      "required": ["identity"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/CallerIdentity"
        },
        "policyResults": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VisibilityDecision"
          }
        }
      }
    },
    "CallerIdentity": {
      "type": "string",
      "enum": ["present", "absent", "unknown"]
    },
    "VisibilityDecision": {
      "type": "string",
      "enum": ["allow", "deny", "unknown"]
    },
    "SearchFixture": {
      "title": "SearchFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "search"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tools", "query"],
          "properties": {
            "tools": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/SearchTool"
              }
            },
            "query": {
              "type": "string"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "expected": {
          "title": "SearchExpectation",
          "type": "object",
          "additionalProperties": false,
          "required": ["names"],
          "properties": {
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "SearchTool": {
      "title": "SearchTool",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "route"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,255}$"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "alternateRoutes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        }
      }
    },
    "SchemaSimplificationFixture": {
      "title": "SchemaSimplificationFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "schema-simplification"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape"],
          "properties": {
            "shape": {
              "$ref": "type-shape.schema.json"
            },
            "options": {
              "$ref": "#/$defs/SchemaSimplificationOptions"
            }
          }
        },
        "expected": {
          "title": "SchemaSimplificationExpectation",
          "type": "object",
          "additionalProperties": false,
          "required": ["schema"],
          "properties": {
            "schema": {
              "$ref": "endpoint-descriptor.schema.json#/$defs/JsonSchemaObject"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SchemaDiagnosticCode"
              }
            },
            "defsOrder": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "SchemaSimplificationOptions": {
      "title": "SchemaSimplificationOptions",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dropReadOnlyProperties": {
          "type": "boolean"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "SchemaDiagnosticCode": {
      "title": "SchemaDiagnosticCode",
      "type": "string",
      "enum": [
        "unsupported_dictionary_key",
        "schema_def_name_disambiguated",
        "schema_depth_truncated",
        "unreadable_shape"
      ]
    },
    "CardFixture": {
      "title": "CardFixture",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "input", "expected"],
      "properties": {
        "kind": {
          "const": "card"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "tool": {
              "$ref": "tool-definition.schema.json"
            },
            "decision": {
              "$ref": "#/$defs/VisibilityDecision"
            }
          }
        },
        "expected": {
          "title": "CardExpectation",
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "description", "parameters"],
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "parameters": {
              "type": "string"
            },
            "authUncertain": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "TemplateBodyCuration": {
      "title": "TemplateBodyCuration",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The wire field name."
        },
        "as": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "fill": {
          "$ref": "endpoint-descriptor.schema.json#/$defs/ArgumentFill"
        }
      }
    }
  }
}
