{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "endpoint-descriptor.schema.json",
  "title": "EndpointDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method",
    "route",
    "auth"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "container": {
      "type": "string",
      "minLength": 1
    },
    "containerPrefix": {
      "type": "string",
      "minLength": 1,
      "description": "Container prefix beyani; verilmezse container adindan turetilir."
    },
    "toolName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,255}$",
      "description": "Tam ad beyani; verilirse prefix uygulanmaz."
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "route": {
      "type": "string",
      "pattern": "^/"
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Parameter"
      }
    },
    "requestBody": {
      "$ref": "#/$defs/RequestBody"
    },
    "responses": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[1-5][0-9]{2}$": {
          "$ref": "#/$defs/ResponseBody"
        }
      }
    },
    "auth": {
      "$ref": "#/$defs/Auth"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "Parameter": {
      "title": "Parameter",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "in",
        "required",
        "schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "in": {
          "type": "string",
          "enum": [
            "path",
            "query",
            "header"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "$ref": "#/$defs/JsonSchemaObject"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "RequestBody": {
      "title": "RequestBody",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/JsonSchemaObject"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "ResponseBody": {
      "title": "ResponseBody",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "$ref": "#/$defs/JsonSchemaObject"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Auth": {
      "title": "Auth",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anonymous",
        "policies",
        "imperative"
      ],
      "properties": {
        "anonymous": {
          "$ref": "#/$defs/Anonymity"
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imperative": {
          "type": "boolean"
        }
      }
    },
    "Anonymity": {
      "title": "Anonymity",
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "description": "yes: cerceve anonim isareti tasiyor. no: cerceve yetki beyani var. unknown: hicbir beyan yok, koruma cerceve disinda olabilir."
    },
    "JsonSchemaObject": {
      "title": "JsonSchemaObject",
      "type": "object",
      "additionalProperties": true
    }
  }
}
