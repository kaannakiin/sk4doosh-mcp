{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "endpoint-descriptor.schema.json",
  "title": "EndpointDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["method", "route", "auth"],
  "properties": {
    "operationId": {
      "type": "string",
      "minLength": 1
    },
    "container": {
      "type": "string",
      "minLength": 1
    },
    "containerPrefix": {
      "type": "string",
      "minLength": 1,
      "description": "Container prefix beyani; verilmezse container adindan turetilir."
    },
    "toolName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,255}$",
      "description": "Tam ad beyani; verilirse prefix uygulanmaz."
    },
    "method": {
      "type": "string",
      "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"]
    },
    "route": {
      "type": "string",
      "pattern": "^/"
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Parameter"
      }
    },
    "requestBody": {
      "$ref": "#/$defs/RequestBody"
    },
    "responses": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[1-5][0-9]{2}$": {
          "$ref": "#/$defs/ResponseBody"
        }
      }
    },
    "auth": {
      "$ref": "#/$defs/Auth"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArgumentCuration"
      },
      "description": "Argument curation declarations, keyed by wire name. The SDK collects these from host declarations and reduces them here; they are declarations, not discovered facts."
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ToolVariant"
      },
      "description": "When present, the operation produces exactly one tool per variant and its own toolName and description are unused."
    }
  },
  "$defs": {
    "Parameter": {
      "title": "Parameter",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "in", "required", "schema"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "in": {
          "type": "string",
          "enum": ["path", "query", "header"]
        },
        "required": {
          "type": "boolean"
        },
        "schema": {
          "$ref": "#/$defs/JsonSchemaObject"
        },
        "style": {
          "type": "string",
          "enum": ["form", "spaceDelimited", "pipeDelimited", "deepObject"]
        },
        "explode": {
          "type": "boolean"
        },
        "objectNotation": {
          "type": "string",
          "enum": ["bracket", "dot"],
          "description": "How a deepObject parameter addresses its members on the wire. The discovering SDK writes it for the backend in front of it; absent means bracket."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "RequestBody": {
      "title": "RequestBody",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": {
          "$ref": "#/$defs/JsonSchemaObject"
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "ResponseBody": {
      "title": "ResponseBody",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "$ref": "#/$defs/JsonSchemaObject"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "ArgumentCuration": {
      "title": "ArgumentCuration",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The wire name: a parameter name, a flattened request-body field name, or the body root argument name."
        },
        "as": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "The name the agent sees. The wire name is unchanged. The pattern excludes the characters error-mapping uses to split a reported field name."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Overrides the description the schema carries. There is no way to erase a description."
        },
        "hidden": {
          "$ref": "#/$defs/ArgumentFill"
        }
      }
    },
    "ArgumentFillKind": {
      "title": "ArgumentFillKind",
      "type": "string",
      "enum": ["constant", "deferred", "omit"],
      "description": "constant: a fixed value is written on every call. deferred: the value comes from a registered provider at invoke time. omit: nothing is written and the backend's own default stands."
    },
    "ArgumentFill": {
      "title": "ArgumentFill",
      "description": "How a hidden argument is filled. Present means hidden; absent means visible. Exactly one of value / source may accompany its kind.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ArgumentFillKind"
        },
        "value": {},
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Names a value provider the host registered. Resolved once per invocation, before composition."
        }
      },
      "oneOf": [
        {
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "const": "constant"
            },
            "value": {},
            "source": false
          }
        },
        {
          "required": ["kind", "source"],
          "properties": {
            "kind": {
              "const": "deferred"
            },
            "source": {},
            "value": false
          }
        },
        {
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "omit"
            },
            "value": false,
            "source": false
          }
        }
      ]
    },
    "ToolVariant": {
      "title": "ToolVariant",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,255}$",
          "description": "Absolute: no container prefix is applied."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required, because one description cannot honestly describe two differently curated tools."
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArgumentCuration"
          },
          "description": "Merged with the endpoint's own arguments by whole-record replacement per wire name."
        }
      }
    },
    "Auth": {
      "title": "Auth",
      "type": "object",
      "additionalProperties": false,
      "required": ["anonymous", "policies", "imperative"],
      "properties": {
        "anonymous": {
          "$ref": "#/$defs/Anonymity"
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imperative": {
          "type": "boolean"
        }
      }
    },
    "Anonymity": {
      "title": "Anonymity",
      "type": "string",
      "enum": ["yes", "no", "unknown"],
      "description": "yes: cerceve anonim isareti tasiyor. no: cerceve yetki beyani var. unknown: hicbir beyan yok, koruma cerceve disinda olabilir."
    },
    "JsonSchemaObject": {
      "title": "JsonSchemaObject",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "object",
                "array",
                "string",
                "integer",
                "number",
                "boolean",
                "null"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "object",
                  "array",
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonSchemaObject"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "$ref": "#/$defs/JsonSchemaObject"
        },
        "enum": {
          "type": "array"
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/JsonSchemaObject"
            }
          ]
        },
        "contentEncoding": {
          "type": "string"
        },
        "propertyNames": {
          "$ref": "#/$defs/JsonSchemaObject"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        },
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonSchemaObject"
          }
        },
        "$ref": {
          "type": "string",
          "minLength": 1
        },
        "$defs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonSchemaObject"
          }
        }
      }
    }
  }
}
