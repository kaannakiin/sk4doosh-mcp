{
  "name": "@sk-mcp/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "gen": "node scripts/generate-types.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "bench:search": "pnpm run build && node --expose-gc bench/search.mjs",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.1",
    "@sk-mcp/oxlint-config": "workspace:*",
    "@sk-mcp/spec": "workspace:*",
    "@sk-mcp/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "1.85.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
