{
  "kind": "argument-mapping",
  "description": "grup path parametresi ve skaler query ile birlikte dogru yere yazilir",
  "input": {
    "template": {
      "method": "GET",
      "route": "/orders/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "integer"
        },
        {
          "name": "filter",
          "in": "query",
          "type": "object",
          "notation": "dot",
          "members": [
            {
              "name": "status",
              "type": "string"
            }
          ]
        },
        {
          "name": "take",
          "in": "query",
          "type": "integer"
        }
      ]
    },
    "arguments": {
      "id": 7,
      "filter": {
        "status": "open"
      },
      "take": 5
    }
  },
  "expected": {
    "pathAndQuery": "/orders/7?filter.status=open&take=5"
  }
}
