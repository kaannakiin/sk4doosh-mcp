{
  "kind": "argument-mapping",
  "description": "text/plain icerikli cerez degeri kodlanarak yazilir",
  "input": {
    "template": {
      "method": "GET",
      "route": "/items",
      "parameters": [
        {
          "name": "note",
          "in": "cookie",
          "type": "string",
          "contentType": "text/plain"
        }
      ]
    },
    "arguments": {
      "note": "a b"
    }
  },
  "expected": {
    "pathAndQuery": "/items",
    "headers": {
      "cookie": "note=a%20b"
    }
  }
}
