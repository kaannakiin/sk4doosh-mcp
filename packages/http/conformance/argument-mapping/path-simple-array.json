{
  "kind": "argument-mapping",
  "description": "simple stili path dizisini virgulle katlar",
  "input": {
    "template": {
      "method": "GET",
      "route": "/items/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "integer",
          "array": true
        }
      ]
    },
    "arguments": {
      "id": [1, 2, 3]
    }
  },
  "expected": {
    "pathAndQuery": "/items/1,2,3"
  }
}
