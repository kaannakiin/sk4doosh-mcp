{
  "kind": "argument-mapping",
  "description": "adsiz metin dosyasi alan adini ve text/plain utf-8 tipini alir",
  "input": {
    "template": {
      "method": "POST",
      "route": "/tickets",
      "body": {
        "properties": ["attachment"]
      },
      "contentType": "multipart/form-data",
      "form": {
        "fields": [
          {
            "name": "attachment",
            "type": "file"
          }
        ]
      }
    },
    "arguments": {
      "attachment": {
        "text": "merhaba"
      }
    }
  },
  "expected": {
    "pathAndQuery": "/tickets",
    "contentType": "multipart/form-data",
    "bodyParts": [
      {
        "name": "attachment",
        "file": {
          "text": "merhaba",
          "filename": "attachment",
          "mediaType": "text/plain; charset=utf-8"
        }
      }
    ]
  }
}
