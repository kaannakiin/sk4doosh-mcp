{
  "kind": "argument-mapping",
  "description": "ref dosyada ajanin adi ve tipi korunur",
  "input": {
    "template": {
      "method": "POST",
      "route": "/tickets",
      "body": {
        "properties": ["attachment"]
      },
      "contentType": "multipart/form-data",
      "form": {
        "fields": [
          {
            "name": "attachment",
            "type": "file"
          }
        ]
      },
      "fileSources": ["text", "base64", "ref"]
    },
    "arguments": {
      "attachment": {
        "ref": "att-1",
        "name": "x.pdf",
        "mediaType": "application/pdf"
      }
    }
  },
  "expected": {
    "pathAndQuery": "/tickets",
    "contentType": "multipart/form-data",
    "bodyParts": [
      {
        "name": "attachment",
        "file": {
          "ref": "att-1",
          "filename": "x.pdf",
          "mediaType": "application/pdf"
        }
      }
    ]
  }
}
