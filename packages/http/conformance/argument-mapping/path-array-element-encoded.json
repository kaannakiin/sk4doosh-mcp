{
  "kind": "argument-mapping",
  "description": "path dizisi elemanlari ayri ayri kodlanir; eleman icindeki virgul ve egik cizgi tek eleman kalir",
  "input": {
    "template": {
      "method": "GET",
      "route": "/items/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "string",
          "array": true
        }
      ]
    },
    "arguments": {
      "id": ["a,b", "c/d"]
    }
  },
  "expected": {
    "pathAndQuery": "/items/a%2Cb,c%2Fd"
  }
}
