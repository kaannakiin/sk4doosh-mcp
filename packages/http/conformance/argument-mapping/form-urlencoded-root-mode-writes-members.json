{
  "kind": "argument-mapping",
  "description": "kok modda govde argumaninin uyeleri form alani olarak yazilir; path parametresi ayri kalir",
  "input": {
    "template": {
      "method": "POST",
      "route": "/tickets/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "integer"
        }
      ],
      "bodyRoot": "body",
      "contentType": "application/x-www-form-urlencoded",
      "form": {
        "fields": [
          {
            "name": "id",
            "type": "integer"
          },
          {
            "name": "note",
            "type": "string"
          }
        ]
      }
    },
    "arguments": {
      "id": 7,
      "body": {
        "id": 42,
        "note": "n"
      }
    }
  },
  "expected": {
    "pathAndQuery": "/tickets/7",
    "contentType": "application/x-www-form-urlencoded",
    "bodyForm": "id=42&note=n"
  }
}
