{
  "name": "@sk-mcp/openapi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "dev": "tsc --watch",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sk-mcp/core": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@sk-mcp/oxlint-config": "workspace:*",
    "@sk-mcp/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
