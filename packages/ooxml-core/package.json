{
  "name": "@sk-mcp/ooxml-core",
  "version": "0.1.0",
  "description": "Shared reader for OOXML containers: zip part source, OPC package, relationships, content types, single-pass XML part scanning.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "tsc"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@sk-mcp/eslint-config": "workspace:*",
    "@sk-mcp/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.9.1",
    "jszip": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
