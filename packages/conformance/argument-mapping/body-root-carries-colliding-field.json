{
  "kind": "argument-mapping",
  "description": "Cakisma yuzunden sarilan govde dogru bestelenir: path parametresi yol'a, ayni adi tasiyan govde alani govdeye gider",
  "input": {
    "template": {
      "method": "PUT",
      "route": "/orders/{id}",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "type": "integer"
        }
      ],
      "bodyRoot": "body"
    },
    "arguments": {
      "id": 7,
      "body": { "id": 42, "item": "kalem" }
    }
  },
  "expected": {
    "pathAndQuery": "/orders/7",
    "bodyJson": { "id": 42, "item": "kalem" }
  }
}
