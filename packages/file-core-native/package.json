{
  "name": "@sk-mcp/file-core-native",
  "version": "0.2.0",
  "description": "Handle-relative filesystem access for file-core (Node-API).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
