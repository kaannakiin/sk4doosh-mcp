{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "gen": {
      "inputs": ["scripts/**", "$TURBO_ROOT$/packages/spec/schemas/**"],
      "outputs": ["src/SkMcp.AspNetCore/Generated/**"]
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "gen"],
      "outputs": [
        "samples/**/bin/**",
        "samples/**/obj/**",
        "src/**/bin/**",
        "src/**/obj/**",
        "tests/**/bin/**",
        "tests/**/obj/**"
      ]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "gen"],
      "inputs": ["src/**", "tests/**", "samples/**", "$TURBO_ROOT$/packages/conformance/**"],
      "outputs": []
    },
    "pack": {
      "dependsOn": ["$TURBO_EXTENDS$", "gen"],
      "outputs": ["local/nupkg-feed/**"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "gen"]
    }
  }
}
