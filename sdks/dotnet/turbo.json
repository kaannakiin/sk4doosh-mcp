{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "gen": {
      "inputs": [
        "scripts/**",
        "$TURBO_ROOT$/packages/http/spec/schemas/**",
        "$TURBO_ROOT$/packages/http/spec/package.json"
      ],
      "outputs": ["src/Liaiso.AspNetCore/Generated/**"]
    },
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "gen"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/packages/http/conformance/**"],
      "outputs": [
        "samples/**/bin/**",
        "samples/**/obj/**",
        "src/**/bin/**",
        "src/**/obj/**",
        "tests/**/bin/**",
        "tests/**/obj/**"
      ]
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "gen"],
      "inputs": ["src/**", "tests/**", "samples/**", "$TURBO_ROOT$/packages/http/conformance/**"],
      "outputs": []
    },
    "pack": {
      "dependsOn": ["$TURBO_EXTENDS$", "gen"],
      "outputs": ["local/nupkg-feed/**"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "gen"]
    }
  }
}
