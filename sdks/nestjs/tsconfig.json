{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@liaiso/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"]
