# Runtime
NODE_ENV=development
CHAT_API_PORT=5191
CHAT_CORS_ORIGIN=http://localhost:5190
# Path the API is mounted under. Auth cookie paths are derived from it, so it
# must match the path the browser actually requests, proxy included.
CHAT_API_PATH_PREFIX=/api
# Number of trusted reverse-proxy hops. Keep 0 when the API is reached directly.
CHAT_TRUST_PROXY_HOPS=0

# First-party web session auth
# Required: one base64-encoded 32-byte root secret. Generate with:
# openssl rand -base64 32
CHAT_AUTH_SECRET=
# Browser-reachable origin of this API, used when OAuth callback URLs are built.
# Defaults to CHAT_CORS_ORIGIN, which is correct whenever the web app proxies
# the API under its own origin. Set it only for a separately hosted API.
# CHAT_AUTH_PUBLIC_API_URL=http://localhost:5190
# Optional frontend destination after OAuth. Defaults to /auth/callback on
# CHAT_CORS_ORIGIN.
# CHAT_AUTH_WEB_REDIRECT_URL=http://localhost:5190/auth/callback
# Must be true in production.
CHAT_AUTH_COOKIE_SECURE=false
# lax when the web app proxies this API under its own origin, which is the
# default shape. Set none only when the API answers on its own site: a Lax cookie
# is withheld from every cross-site request, so the session would never be sent.
# none requires CHAT_AUTH_COOKIE_SECURE=true or the browser discards the cookie,
# and it costs a server-rendered first paint that always looks anonymous.
CHAT_AUTH_COOKIE_SAMESITE=lax
# Issuer, audience and token/challenge lifetimes are product constants in
# contracts/src/auth/auth.ts. Refresh tokens are opaque and hashed in Postgres;
# they do not use a separate signing secret.
# OTP delivery currently logs only in development. Production refuses to start
# until LoggingOtpDelivery is replaced with a real email/SMS adapter.

# OAuth providers are disabled when all three values in their group are absent.
# A partially configured group fails startup validation.
# CHAT_AUTH_GOOGLE_CLIENT_ID=
# CHAT_AUTH_GOOGLE_CLIENT_SECRET=
# CHAT_AUTH_GOOGLE_REDIRECT_URI=http://localhost:5190/api/auth/oauth/google/callback
# CHAT_AUTH_GITHUB_CLIENT_ID=
# CHAT_AUTH_GITHUB_CLIENT_SECRET=
# CHAT_AUTH_GITHUB_REDIRECT_URI=http://localhost:5190/api/auth/oauth/github/callback

# Shared Redis storage for rate limits. Production requires an authenticated
# rediss:// connection.
CHAT_REDIS_URL=redis://127.0.0.1:6379
CHAT_REDIS_KEY_PREFIX=chat
CHAT_REDIS_CONNECT_TIMEOUT_MS=2000
CHAT_REDIS_COMMAND_TIMEOUT_MS=1000

# PostgreSQL
# Required. The API does not provide an in-memory database fallback.
CHAT_DATABASE_URL=
CHAT_DB_POOL_MAX=10
# Optional and used only by `prisma migrate dev`, not by the running API.
# Set this when the database role cannot create Prisma's temporary shadow DB.
# CHAT_DATABASE_SHADOW_URL=

# LLM provider. Base URL must be the host root without an /api suffix.
CHAT_LLM_BASE_URL=http://127.0.0.1:11434
CHAT_LLM_MODEL=qwen3:8b
# Optional for providers that require bearer authentication.
# CHAT_LLM_API_KEY=
# Explicit context size prevents shared Ollama runners inheriting another
# caller's num_ctx. Raising it increases KV-cache memory use.
CHAT_LLM_CONTEXT_TOKENS=16384
CHAT_LLM_KEEP_ALIVE=10m

# Upload session limits
# Per-file limit must not exceed the total per-session byte budget.
CHAT_UPLOAD_MAX_FILE_BYTES=15728640
CHAT_UPLOAD_MAX_BYTES=26214400
CHAT_UPLOAD_MAX_FILES=8
CHAT_SESSION_IDLE_TTL_MS=1800000

# S3-compatible object storage
# CHAT_S3_ENDPOINT is server-reachable. CHAT_S3_PUBLIC_ENDPOINT is optional and
# must preserve the signed Host exactly when browsers use another origin.
CHAT_S3_ENDPOINT=
# CHAT_S3_PUBLIC_ENDPOINT=
# Required. The bucket must already exist; the API never creates it.
CHAT_S3_BUCKET=
CHAT_S3_ACCESS_KEY=
CHAT_S3_SECRET_KEY=
CHAT_S3_REGION=us-east-1
CHAT_S3_FORCE_PATH_STYLE=true
# Presigned URLs are bearer credentials; keep their lifetime short.
CHAT_S3_PRESIGN_TTL_S=300
CHAT_S3_TIMEOUT_MS=15000

# Process-local attachment cache. CHAT_CACHE_ROOT defaults to an OS temp path,
# is wiped at startup and must never point to shared or durable storage.
# CHAT_CACHE_ROOT=
CHAT_CACHE_MAX_BYTES=2147483648
CHAT_SANDBOX_TTL_MS=1800000

# Reader MCP processes. Build these packages before starting the API. Commands
# are split without a shell, then the sandbox root is appended as the last arg.
CHAT_MCP_EXCEL_CMD=node ../../../packages/servers/excel-mcp/dist/cli.js
CHAT_MCP_XML_CMD=node ../../../packages/servers/xml-mcp/dist/cli.js
CHAT_MCP_MAX_SESSIONS=8

# Coding agent. CHAT_CODEX_HOME is the whole of its authentication: no api key is
# ever passed to the sdk, so whichever credential lives in that directory is the
# one the agent runs under. Set it up once with:
#   mkdir -p ../../../.codex-home
#   CODEX_HOME=../../../.codex-home pnpm exec codex login
# Leave it unset to turn the agent off; the tool is then never offered.
# CHAT_CODEX_HOME=../../../.codex-home
# CHAT_CODEX_BIN=
# CHAT_CODEX_BASE_URL=
# CHAT_CODEX_MODEL=
# Working directories, one per conversation. Never point this at CHAT_CACHE_ROOT:
# that root is wiped at boot and evicted across sessions under byte pressure.
# CHAT_CODEX_ROOT=
CHAT_CODEX_TIMEOUT_MS=600000
CHAT_CODEX_MAX_WORKSPACES=4
# Local model for the agent. Codex starts llm-mcp itself, pointed at
# CHAT_LLM_BASE_URL and CHAT_LLM_MODEL. Build it first:
#   pnpm turbo run build --filter=@sk-mcp/llm-mcp
# Leave it unset and the agent runs without a local model.
# CHAT_CODEX_LLM_MCP_ENTRY=../../../packages/servers/llm-mcp/dist/cli.js

# Optional. Binds tool approvals to this server. Generate with:
# openssl rand -base64 32
# CHAT_TOOL_APPROVAL_SECRET=

# Seeding only, read by `pnpm turbo run db:seed --filter=@chat/api`. The seeded
# account skips contact verification, and on an address that already exists it
# overwrites that account's password. Leave unset outside development.
# CHAT_SEED_EMAIL=
# CHAT_SEED_PASSWORD=
# CHAT_SEED_FIRST_NAME=
# CHAT_SEED_LAST_NAME=
