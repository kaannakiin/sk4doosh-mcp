CHAT_API_PORT=5191
CHAT_DEFAULT_LOCALE=en
CHAT_CORS_ORIGIN=http://localhost:5190

# Company Ollama host, e.g. http://10.0.0.12:11434 (host root, no /api suffix).
CHAT_LLM_BASE_URL=http://127.0.0.1:11434
# Must be a tool-capable model that is already pulled on that host.
CHAT_LLM_MODEL=qwen3:8b
# CHAT_LLM_API_KEY=
# Declared, not inherited: Ollama keys a model runner on num_ctx, so leaving this
# unset means the window is whatever the last caller on the host asked for.
# KV cache for qwen3.8 costs ~0.25 GB per 1k tokens on top of 16.5 GB of weights,
# so raising this needs the VRAM and starts a second runner for the same model.
CHAT_LLM_CONTEXT_TOKENS=16384
CHAT_LLM_KEEP_ALIVE=10m

CHAT_UPLOAD_MAX_BYTES=26214400
CHAT_UPLOAD_MAX_FILES=8
CHAT_SESSION_IDLE_TTL_MS=1800000

# The reader MCP servers are spawned as child processes, never imported.
# Build them first: pnpm turbo run build --filter=@sk-mcp/excel-mcp --filter=@sk-mcp/xml-mcp
# The sandbox root is appended by the api as the final positional argument.
CHAT_MCP_EXCEL_CMD=node ../../../packages/excel-mcp/dist/cli.js
CHAT_MCP_XML_CMD=node ../../../packages/xml-mcp/dist/cli.js
CHAT_MCP_MAX_SESSIONS=8

# openssl rand -base64 32 — binds each tool approval to this server.
# CHAT_TOOL_APPROVAL_SECRET=

# Postgres is external and operator supplied; there is no compose file in this
# repo. Required — the api refuses to boot without it.
CHAT_DATABASE_URL=
# `prisma migrate dev` creates and drops a shadow database on the same server,
# which needs CREATEDB on the role. Managed Postgres often withholds it: create
# one empty database by hand and point this at it. `migrate deploy` needs neither.
CHAT_DATABASE_SHADOW_URL=
CHAT_DB_POOL_MAX=10

# Server-side endpoint. The api reaches MinIO here; the browser never does.
CHAT_S3_ENDPOINT=
# Browser-reachable endpoint. SigV4 signs the Host header, so a URL signed for
# CHAT_S3_ENDPOINT is rejected once the browser sends a different Host. Must be a
# bare-origin passthrough: a proxy that adds a path prefix or rewrites Host
# changes the canonical request and breaks every signature. Leaving this equal to
# CHAT_S3_ENDPOINT hides that whole class of bug until deployment.
CHAT_S3_PUBLIC_ENDPOINT=
# The api verifies this bucket exists at boot and never creates it — creating one
# under wrong credentials is a silent failure that looks like data loss later.
CHAT_S3_BUCKET=
CHAT_S3_ACCESS_KEY=
CHAT_S3_SECRET_KEY=
# MinIO ignores region for routing but SigV4 signs it, so a mismatch with the
# server's MINIO_REGION surfaces only as SignatureDoesNotMatch.
CHAT_S3_REGION=us-east-1
CHAT_S3_FORCE_PATH_STYLE=true
# A presigned URL is a bearer credential: it lands in browser history, in Referer
# and in any proxy log that records query strings, and it keeps working after the
# row and the object are deleted. Short enough that a leaked URL is worthless
# before it is read, long enough to survive a slow image load.
CHAT_S3_PRESIGN_TTL_S=300
CHAT_S3_TIMEOUT_MS=15000

# Local materialization cache for the MCP readers, not a store. Objects in MinIO
# are the record; this directory is rebuilt on demand and wiped at boot, so it
# must be process-local and never a shared volume.
CHAT_CACHE_ROOT=
CHAT_CACHE_MAX_BYTES=2147483648
CHAT_SANDBOX_TTL_MS=1800000
# Multer aborts mid-stream at this ceiling, so an oversized upload is never
# buffered whole. It is the per-file limit; CHAT_UPLOAD_MAX_BYTES is the
# per-session budget and is enforced against Postgres after the fact.
CHAT_UPLOAD_MAX_FILE_BYTES=15728640

# Anonymous ownership. The cookie is httpOnly and SameSite=Lax, which only works
# because the web dev server proxies the api under its own origin.
CHAT_OWNER_COOKIE_TTL_MS=31536000000
CHAT_OWNER_COOKIE_SECURE=false
