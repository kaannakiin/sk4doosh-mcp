{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tags": ["chat"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "build"],
      "passThroughEnv": [
        "CHAT_API_PORT",
        "CHAT_DEFAULT_LOCALE",
        "CHAT_CORS_ORIGIN"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CHAT_API_PORT",
        "CHAT_DEFAULT_LOCALE",
        "CHAT_CORS_ORIGIN"
      ]
    },
    "dev:types": {
      "cache": false,
      "persistent": true
    }
  }
}
