{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tags": ["chat", "chat-server"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "build"],
      "passThroughEnv": [
        "PATH",
        "CHAT_API_PORT",
        "CHAT_CORS_ORIGIN",
        "CHAT_LLM_BASE_URL",
        "CHAT_LLM_MODEL",
        "CHAT_LLM_API_KEY",
        "CHAT_LLM_CONTEXT_TOKENS",
        "CHAT_LLM_KEEP_ALIVE",
        "CHAT_UPLOAD_MAX_BYTES",
        "CHAT_UPLOAD_MAX_FILES",
        "CHAT_SESSION_IDLE_TTL_MS",
        "CHAT_MCP_EXCEL_CMD",
        "CHAT_MCP_XML_CMD",
        "CHAT_MCP_PDF_CMD",
        "CHAT_MCP_PDF_OCR_URL",
        "CHAT_MCP_PDF_OCR_MODEL",
        "CHAT_MCP_MAX_SESSIONS",
        "CHAT_CODEX_HOME",
        "CHAT_CODEX_BIN",
        "CHAT_CODEX_BASE_URL",
        "CHAT_CODEX_ROOT",
        "CHAT_CODEX_MODEL",
        "CHAT_CODEX_TIMEOUT_MS",
        "CHAT_CODEX_MAX_WORKSPACES",
        "CHAT_CODEX_LLM_MCP_ENTRY",
        "CHAT_TOOL_APPROVAL_SECRET",
        "CHAT_CONNECTIONS_WEB_REDIRECT_URL",
        "CHAT_DATABASE_URL",
        "CHAT_DB_POOL_MAX",
        "CHAT_S3_ENDPOINT",
        "CHAT_S3_PUBLIC_ENDPOINT",
        "CHAT_S3_BUCKET",
        "CHAT_S3_ACCESS_KEY",
        "CHAT_S3_SECRET_KEY",
        "CHAT_S3_REGION",
        "CHAT_S3_FORCE_PATH_STYLE",
        "CHAT_S3_PRESIGN_TTL_S",
        "CHAT_S3_TIMEOUT_MS",
        "CHAT_CACHE_ROOT",
        "CHAT_CACHE_MAX_BYTES",
        "CHAT_SANDBOX_TTL_MS",
        "CHAT_UPLOAD_MAX_FILE_BYTES"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PATH",
        "CHAT_API_PORT",
        "CHAT_CORS_ORIGIN",
        "CHAT_LLM_BASE_URL",
        "CHAT_LLM_MODEL",
        "CHAT_LLM_API_KEY",
        "CHAT_LLM_CONTEXT_TOKENS",
        "CHAT_LLM_KEEP_ALIVE",
        "CHAT_UPLOAD_MAX_BYTES",
        "CHAT_UPLOAD_MAX_FILES",
        "CHAT_SESSION_IDLE_TTL_MS",
        "CHAT_MCP_EXCEL_CMD",
        "CHAT_MCP_XML_CMD",
        "CHAT_MCP_PDF_CMD",
        "CHAT_MCP_PDF_OCR_URL",
        "CHAT_MCP_PDF_OCR_MODEL",
        "CHAT_MCP_MAX_SESSIONS",
        "CHAT_CODEX_HOME",
        "CHAT_CODEX_BIN",
        "CHAT_CODEX_BASE_URL",
        "CHAT_CODEX_ROOT",
        "CHAT_CODEX_MODEL",
        "CHAT_CODEX_TIMEOUT_MS",
        "CHAT_CODEX_MAX_WORKSPACES",
        "CHAT_CODEX_LLM_MCP_ENTRY",
        "CHAT_TOOL_APPROVAL_SECRET",
        "CHAT_CONNECTIONS_WEB_REDIRECT_URL",
        "CHAT_DATABASE_URL",
        "CHAT_DB_POOL_MAX",
        "CHAT_S3_ENDPOINT",
        "CHAT_S3_PUBLIC_ENDPOINT",
        "CHAT_S3_BUCKET",
        "CHAT_S3_ACCESS_KEY",
        "CHAT_S3_SECRET_KEY",
        "CHAT_S3_REGION",
        "CHAT_S3_FORCE_PATH_STYLE",
        "CHAT_S3_PRESIGN_TTL_S",
        "CHAT_S3_TIMEOUT_MS",
        "CHAT_CACHE_ROOT",
        "CHAT_CACHE_MAX_BYTES",
        "CHAT_SANDBOX_TTL_MS",
        "CHAT_UPLOAD_MAX_FILE_BYTES"
      ]
    },
    "dev:types": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "db:seed": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "CHAT_DATABASE_URL",
        "CHAT_SEED_EMAIL",
        "CHAT_SEED_PASSWORD",
        "CHAT_SEED_FIRST_NAME",
        "CHAT_SEED_LAST_NAME"
      ]
    }
  }
}
