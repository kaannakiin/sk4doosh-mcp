{
  "name": "@chat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --watch-preserve-output dist/main.js",
    "dev:types": "tsc --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:seed": "node dist/seed.js",
    "gen:codex-protocol": "node scripts/gen-codex-protocol.mjs"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.48",
    "@chat/contracts": "workspace:*",
    "@chat/db": "workspace:*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@openai/codex": "^0.154.0",
    "@openai/codex-sdk": "^0.154.0",
    "ai": "^7.0.97",
    "ai-sdk-ollama": "^4.3.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "i18next": "^26.4.2",
    "jose": "^6.2.12",
    "minio": "8.0.7",
    "oauth4webapi": "^3.8.8",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@sk-mcp/oxlint-config": "workspace:*",
    "@sk-mcp/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "oxlint": "1.85.0",
    "supertest": "^7.2.2",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  }
}
