{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tags": ["chat"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tanstack/**"],
      "env": ["VITE_CHAT_API_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": ["VITE_CHAT_API_URL"]
    }
  }
}
