{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@liaiso/typescript-config/react-library.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node", "vite/client", "@webgpu/types"],
    "allowImportingTsExtensions": true,
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts", "oxlint.config.ts"],
  "exclude": ["node_modules", "dist", ".tanstack"]
}
