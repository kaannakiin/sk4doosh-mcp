enum IntegrationOrigin {
  partner
  user
}

/// Whether a server asks this platform for a token at all.
///
/// Guard: stored, never inferred from the absence of an authorization row. A
/// row whose discovery failed halfway also has no authorization row, and
/// reading that as "needs no token" would present a guarded server's tools with
/// no credential.
enum IntegrationAuthMode {
  oauth
  none
}

enum IntegrationStatus {
  active
  disabled
}

enum ConnectionStatus {
  active
  revoked
  reauth_required
}

enum ConnectionEventKind {
  connected
  reconnected
  revoked
  reauth_required
}

enum DiscoveryFailure {
  resource_mismatch
  issuer_mismatch
  insecure_transport
  pkce_unsupported
  blocked_address
  unreachable
  malformed
}
