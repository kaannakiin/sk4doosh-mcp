/// A tool one reader decided not to be asked about again.
///
/// Guard: identity is `subject_key`, not the integration and tool name it was
/// once keyed by. A first-party tool has no integration row to be named by, and
/// the reader approving one is approving the same kind of thing whether the
/// model reached it through a remote server or not — keying them apart is what
/// left this product trusting its own readers less than a server it had never
/// met. The key is `<integration public id>:<tool name>` for a discovered tool
/// and the bare name for a shipped one; the two shapes cannot collide because
/// ':' appears in neither half.
///
/// Guard: the exposed name never reaches this table. That name is derived and
/// lossy, and `ToolApprovalService.resolve` already refuses to invert it by
/// splitting the string — storing it would make that refusal pointless.
///
/// Guard: `integration_id` is no longer identity and is kept only so removing an
/// integration still reaps the grants that named its tools. `ON DELETE CASCADE`
/// is the one form of that a code path cannot forget to run. The cost is a
/// second value that can disagree with `subject_key`, which no CHECK can catch
/// because verifying it needs a subquery — both are written from one resolved
/// row in `remember()`, and that is the whole of the guarantee.
///
/// Guard: there is no relation to `IntegrationTool`. That table is rewritten
/// wholesale on every refresh, so a foreign key would cascade these rows away
/// hourly, and a server answering with an empty list during an outage would
/// erase consent the reader gave permanently. A tool the server no longer offers
/// is reported as unavailable by the read path instead.
///
/// Guard: the digest is stored beside the grant and compared on every call. The
/// consent was given for the definition the reader read, not for the name — a
/// server that keeps a name and rewrites what the tool does must ask again.
///
/// Guard: the digest is not part of the key. Approvals are permanent, so a key
/// that changed with the definition would leave a dead row behind every time a
/// server edited a description, with nothing to reap them and three rows for one
/// tool on the reader's page.
///
/// Guard: `scope_key` is `''` for a grant that reaches everywhere, never null. It
/// is part of the primary key, and a primary key may not contain nulls under any
/// setting — PG15's `UNIQUE NULLS NOT DISTINCT` is a unique constraint and not a
/// primary key, and Prisma's compound-unique input has no way to spell null,
/// which is what `upsert` addresses this table by.
///
/// Guard: an expired grant is kept, not swept. Expiry means the row goes quiet;
/// deleting it is a different and stronger thing, and a background job whose only
/// verb is DELETE has no business on the table that records consent. Re-granting
/// refreshes the same row through the same key.
model ToolApproval {
  userId           BigInt    @map("user_id")
  subjectKey       String    @map("subject_key")
  scopeKey         String    @default("") @map("scope_key")
  integrationId    BigInt?   @map("integration_id")
  toolName         String    @map("tool_name")
  definitionDigest Bytes     @map("definition_digest")
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Guard: `onDelete: Cascade` is stated although the column is now optional.
  /// Prisma defaults an optional relation to `SetNull`, and accepting that
  /// default silently is the one way this change stops reaping anything.
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([userId, subjectKey, scopeKey])
  @@index([integrationId], map: "tool_approval_integration_idx")
  @@map("tool_approval")
}

/// How one reader wants the tools of one integration approved, in place of their
/// own mode.
///
/// Guard: no row means the reader's own mode applies. Absence is "inherit", so a
/// partner integration offered to everyone starts from each reader's own choice
/// rather than from a posture nobody picked.
model IntegrationApprovalSetting {
  userId        BigInt                  @map("user_id")
  integrationId BigInt                  @map("integration_id")
  mode          IntegrationApprovalMode
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([userId, integrationId])
  @@index([integrationId], map: "integration_approval_setting_integration_idx")
  @@map("integration_approval_setting")
}

/// One reader's standing decision about one tool: ask every time, or never.
///
/// Guard: this is the only thing that outranks a server's destructive hint, and
/// it is written one tool at a time by the reader. Loosening a destructive tool
/// is therefore always an explicit decision about that tool, never a side effect
/// of an integration's mode.
///
/// Guard: an `auto` row carries the digest of the definition it was given for,
/// and stops applying when the definition changes — a server that keeps a name
/// and rewrites what the tool does must ask again. An `always_ask` row carries
/// none: asking more can never be the wrong answer to a changed definition.
model ToolApprovalOverride {
  userId           BigInt           @map("user_id")
  subjectKey       String           @map("subject_key")
  integrationId    BigInt?          @map("integration_id")
  toolName         String           @map("tool_name")
  mode             ToolOverrideMode
  definitionDigest Bytes?           @map("definition_digest")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([userId, subjectKey])
  @@index([integrationId], map: "tool_approval_override_integration_idx")
  @@map("tool_approval_override")
}
