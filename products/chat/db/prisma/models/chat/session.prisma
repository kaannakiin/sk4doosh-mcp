/// Guard: `publicId` is the only identifier that leaves this process. It is
/// minted by the browser with `crypto.randomUUID()` before the server has ever
/// heard of the session, because `useChat({ id })` keys on it, and it doubles as
/// the sandbox directory name — which is what the uuid constraint makes safe by
/// construction. `id` is the internal surrogate every foreign key and index
/// carries; it must never appear in a response, a cursor or an object key.
model ChatSession {
  id           BigInt    @id @default(autoincrement())
  publicId     String    @unique @map("public_id") @db.Uuid
  userId       BigInt    @map("user_id")
  title        String?
  messageCount Int       @default(0) @map("message_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  /// The sidebar's sort key: bumped when the reader opens the conversation and
  /// on every turn. Kept apart from `updatedAt`, which only a turn may move.
  lastOpenedAt DateTime  @default(now()) @map("last_opened_at") @db.Timestamptz
  pinnedAt     DateTime? @map("pinned_at") @db.Timestamptz

  /// The Codex thread this conversation continues, as the agent's own runtime
  /// named it. It is a handle into `$CODEX_HOME/sessions`, not an identifier
  /// this product mints, so it is never projected into a row type and never
  /// leaves the process — resuming a thread is the only thing it is read for.
  codexThreadId String? @map("codex_thread_id")

  /// The app-server thread that runs this conversation as its main agent. Kept
  /// apart from `codexThreadId`, which names a delegated `codex_task` thread that
  /// never saw the conversation it was called from.
  agentThreadId String? @map("agent_thread_id")

  agentCodexModel  String? @map("agent_codex_model")
  agentEffort      String? @map("agent_effort")
  agentWorkerModel String? @map("agent_worker_model")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  attachments ChatAttachment[]

  @@index([userId, lastOpenedAt(sort: Desc), id(sort: Desc)], map: "chat_session_user_recent_idx")
  @@map("chat_session")
}
