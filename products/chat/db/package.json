{
  "name": "@chat/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "gen": "prisma generate",
    "build": "tsc",
    "lint": "oxlint --deny-warnings",
    "check-types": "tsc --noEmit && tsc -p tsconfig.tools.json && tsc -p tsconfig.test.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test": "vitest run",
    "test:integration": "CHAT_RUN_DB_TESTS=true vitest run test/auth.integration.spec.ts"
  },
  "dependencies": {
    "@chat/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@liaiso/oxlint-config": "workspace:*",
    "@liaiso/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.0",
    "oxlint": "1.85.0",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.4",
    "zod": "^4.5.4"
  }
}
