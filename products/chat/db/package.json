{
  "name": "@chat/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "gen": "prisma generate",
    "build": "tsc",
    "lint": "eslint .",
    "check-types": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@chat/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@sk-mcp/eslint-config": "workspace:*",
    "@sk-mcp/typescript-config": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.0",
    "eslint": "10.9.1",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "zod": "^4.5.4"
  }
}
