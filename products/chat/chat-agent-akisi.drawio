                <mxCell id="sm_trap" value="&lt;b&gt;Tuzak&lt;/b&gt;&#xa;approval-responded ilerlemezse predicate true kalir,&#xa;her stream sonunda yeniden POST atilir. Cikis kosulu yok.&#xa;242 istek bundan geldi. Sunucu tarafi duzeldi,&#xa;istemci tarafinda hala tavan yok." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
